# MongoDB connection string (Atlas or self-hosted)
MONGODB_URI=

# Public origin — public form links are built as ${BASE_URL}/f/<formId>
BASE_URL=http://localhost:3000

# Auth.js secret (openssl rand -base64 32) and trust-host for self-hosting
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Google OAuth web client. The production client must carry the redirect URI
# https://<your-domain>/api/auth/callback/google (plus any localhost origins
# used for development).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional email via Amazon SES. Unset: signup still creates the account
# but it stays UNVERIFIED until email works — Form-like never auto-verifies.
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_REGION=eu-north-1
MAIL_FROM=no-reply@your-domain.example

# Text generation (stage 3): OpenAI Responses API model id and key
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_API_KEY=

# Jev control selection (stage 3); pinned default with env override
JEV_MODEL=jev-1.14.0
TYPESAFE_API_KEY=

# Private hosted generation instructions override (server-only; never commit)
GENERATION_INSTRUCTIONS_OVERRIDE=

# Hosted allowances (server-side enforcement, stage 3)
AI_OPS_PER_ACCOUNT_PER_DAY=20
MAX_FIELDS_PER_FORM=30
GLOBAL_DAILY_AI_SPEND_CUTOFF_USD=
